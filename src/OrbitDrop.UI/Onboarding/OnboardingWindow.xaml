<Window x:Class="OrbitDrop.UI.Onboarding.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to OrbitDrop" Width="560" Height="500" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Icon="pack://application:,,,/OrbitDrop.UI;component/Assets/orbitdrop.ico"
        FontFamily="{StaticResource Orbit.Font.Text}">
    <Grid x:Name="Root" Margin="36,20,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="200" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Illustrations (one per step, original vector art) ===== -->
        <Border Grid.Row="0" CornerRadius="8" Background="{DynamicResource Orbit.AccentSubtle}">
            <Grid>
                <!-- Step 1: pick up a file -->
                <Canvas x:Name="Art1" Width="240" Height="160">
                    <Border Canvas.Left="66" Canvas.Top="26" Width="74" Height="94" CornerRadius="6" Background="{DynamicResource Orbit.Surface}"
                            BorderBrush="{DynamicResource Orbit.Stroke}" BorderThickness="1" Opacity="0.55" />
                    <Border Canvas.Left="96" Canvas.Top="18" Width="74" Height="94" CornerRadius="6" Background="{DynamicResource Orbit.Surface}"
                            BorderBrush="{DynamicResource Orbit.StrokeStrong}" BorderThickness="1">
                        <Border.RenderTransform><RotateTransform Angle="6" /></Border.RenderTransform>
                        <StackPanel Margin="12,16,12,0">
                            <Border Height="6" CornerRadius="3" Background="{DynamicResource Orbit.Accent}" Width="36" HorizontalAlignment="Left" />
                            <Border Height="5" CornerRadius="2.5" Background="{DynamicResource Orbit.Stroke}" Margin="0,10,0,0" />
                            <Border Height="5" CornerRadius="2.5" Background="{DynamicResource Orbit.Stroke}" Margin="0,7,0,0" />
                            <Border Height="5" CornerRadius="2.5" Background="{DynamicResource Orbit.Stroke}" Margin="0,7,14,0" />
                        </StackPanel>
                    </Border>
                    <Path Canvas.Left="150" Canvas.Top="92" Data="M0,0 L0,24 L6,18 L10,28 L14,26 L10,16 L18,16 Z"
                          Fill="{DynamicResource Orbit.TextPrimary}" Stroke="{DynamicResource Orbit.Surface}" StrokeThickness="1.5" />
                    <Path Canvas.Left="40" Canvas.Top="128" Data="M0,0 C30,14 70,16 110,4" Stroke="{DynamicResource Orbit.Accent}"
                          StrokeThickness="2.5" StrokeDashArray="2 3" StrokeDashCap="Round" Opacity="0.7" />
                </Canvas>

                <!-- Step 2: tap the wheel key -->
                <Canvas x:Name="Art2" Width="240" Height="160" Visibility="Collapsed">
                    <Ellipse Canvas.Left="120" Canvas.Top="18" Width="104" Height="104" Fill="{DynamicResource Orbit.Surface}" Opacity="0.9"
                             Stroke="{DynamicResource Orbit.Stroke}" />
                    <Ellipse Canvas.Left="148" Canvas.Top="46" Width="48" Height="48" Fill="{DynamicResource Orbit.AccentSubtle}" />
                    <Path Canvas.Left="120" Canvas.Top="18" Data="M52,4 A48,48 0 0 1 100,52 L74,52 A22,22 0 0 0 52,30 Z" Fill="{DynamicResource Orbit.Accent}" Opacity="0.9" />
                    <Border Canvas.Left="18" Canvas.Top="72" Width="108" Height="54" CornerRadius="8" Background="{DynamicResource Orbit.Surface}"
                            BorderBrush="{DynamicResource Orbit.StrokeStrong}" BorderThickness="1,1,1,4">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="⇧" FontSize="18" Foreground="{DynamicResource Orbit.TextPrimary}" Margin="0,0,6,0" />
                            <TextBlock x:Name="KeyName" Text="Shift" Style="{StaticResource Orbit.Text.BodyStrong}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Canvas>

                <!-- Step 3: release on an option -->
                <Canvas x:Name="Art3" Width="240" Height="160" Visibility="Collapsed">
                    <Ellipse Canvas.Left="14" Canvas.Top="20" Width="120" Height="120" Fill="{DynamicResource Orbit.Surface}" Stroke="{DynamicResource Orbit.Stroke}" />
                    <Path Canvas.Left="14" Canvas.Top="20" Data="M60,6 A54,54 0 0 1 114,60 L86,60 A26,26 0 0 0 60,34 Z" Fill="{DynamicResource Orbit.Accent}" />
                    <TextBlock Canvas.Left="90" Canvas.Top="44" Text="PNG" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Orbit.OnAccent}" />
                    <Ellipse Canvas.Left="48" Canvas.Top="54" Width="52" Height="52" Fill="{DynamicResource Orbit.SurfaceAlt}" />
                    <Path Canvas.Left="140" Canvas.Top="74" Data="M0,6 L22,6 M16,0 L22,6 L16,12" Stroke="{DynamicResource Orbit.TextTertiary}"
                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    <Border Canvas.Left="170" Canvas.Top="50" Width="56" Height="66" CornerRadius="6" Background="{DynamicResource Orbit.Surface}"
                            BorderBrush="{DynamicResource Orbit.StrokeStrong}" BorderThickness="1">
                        <Grid>
                            <TextBlock Text="PNG" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Orbit.AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource Orbit.Success}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-7,-7">
                                <TextBlock Style="{StaticResource Orbit.Glyph}" Text="&#xE73E;" FontSize="10" Foreground="White" />
                            </Border>
                        </Grid>
                    </Border>
                </Canvas>
            </Grid>
        </Border>

        <!-- ===== Copy ===== -->
        <StackPanel Grid.Row="1" Margin="4,24,4,0">
            <TextBlock x:Name="StepLabel" Style="{StaticResource Orbit.Text.Caption}" Foreground="{DynamicResource Orbit.AccentText}" FontWeight="SemiBold" />
            <TextBlock x:Name="Heading" Style="{StaticResource Orbit.Text.Title}" FontSize="24" LineHeight="32" Margin="0,4,0,8" />
            <TextBlock x:Name="Body" Style="{StaticResource Orbit.Text.Body}" Foreground="{DynamicResource Orbit.TextSecondary}" />
        </StackPanel>

        <!-- ===== Navigation ===== -->
        <DockPanel Grid.Row="2">
            <Button x:Name="SkipButton" DockPanel.Dock="Left" Content="Skip" Style="{StaticResource Orbit.Button.Subtle}" Click="OnSkip" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="BackButton" Content="Back" Style="{StaticResource Orbit.Button.Standard}" Margin="0,0,8,0" Click="OnBack" MinWidth="88" />
                <Button x:Name="NextButton" Content="Next" Style="{StaticResource Orbit.Button.Accent}" Click="OnNext" MinWidth="112" IsDefault="True" />
            </StackPanel>
            <StackPanel x:Name="Dots" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
