<?xml version="1.0" encoding="utf-8"?>
<!--
  Microsoft Store (MSIX) manifest. Identity values come from Partner Center → Product identity and must match it
  exactly. {VERSION} is filled in by build/store/package-store.ps1 (Store versions end in .0).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity
    Name="MohammedEssam.OrbitDrop-DragConvert"
    Publisher="CN=FD78A452-347F-4CF8-BE72-9A808019B3D2"
    Version="{VERSION}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>OrbitDrop - Drag &amp; Convert</DisplayName>
    <PublisherDisplayName>Mohammed Essam</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Convert, edit and manage files without opening an app: drag a file, tap Shift, let go on what you want.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="OrbitDrop" Executable="OrbitDrop.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="OrbitDrop - Drag &amp; Convert"
        Description="Convert, edit and manage files right where they are."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" ShortName="OrbitDrop" />
      </uap:VisualElements>
      <Extensions>
        <!-- "Start OrbitDrop when I sign in" (Settings → General); off until the user turns it on. -->
        <desktop:Extension Category="windows.startupTask" Executable="OrbitDrop.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="OrbitDropStartup" Enabled="false" DisplayName="OrbitDrop" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- A classic desktop app: it watches for file drags system-wide and shows its wheel over other windows. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
